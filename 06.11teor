#include <cstdlib>
#include <iostream>
#include <ctime>
using namespace std;


void Rand_mas(int arr[], int size)
{
    for(int i = 0; i < size; i++)
    {
        arr[i] = 1 + rand() % 50;
        cout << arr[i] << " ";
    }
    cout << endl;
}

void Print(int arr[], int size)
{
    for(int i = 0; i < size; i++)
    {
        cout << arr[i] << " ";
    }
    cout << endl;
}

void Copy_mas(int from[], int to[], int size)
{
    for(int i = 0; i < size; i++)
    {
        to[i] = from[i];
    }
}


int bublesort(int arr[], int size)
{
    int iteration = 0;
    for(int i = 0; i < size - 1; i++)
    {
        bool swap = false;
        for(int j = 0; j < size - 1 - i; j++)
        {
            iteration++;
            if(arr[j] > arr[j + 1])
            {
                int a = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = a;

                swap = true;
            }
        }
        if(!swap)
        {
            break;
        }
    }
    return iteration;
}


int GnomeSort(int arr[], int size)
{
    int iteration = 0;
    int i = 0;
    while(i < size)
    {
        iteration++;
        if(i == 0 || arr[i] >= arr[i - 1])
        {
            i++;
        }
        else
        {
            int temp = arr[i];
            arr[i] = arr[i - 1];
            arr[i - 1] = temp;
            i--;
        }
    }
    return iteration;
}


int stalinSort(int arr[], int size, int &iteration)
{
    iteration = 0;
    if(size <= 0) return 0;

    int j = 0;
    for(int i = 1; i < size; i++)
    {
        iteration++;
        if(arr[i] >= arr[j])
        {
            j++;
            arr[j] = arr[i];
        }
    }
    return j + 1;
}


int selectionSort(int arr[], int size)
{
    int iteration = 0;
    for(int i = 0; i < size - 1; i++)
    {
        int minIndex = i;             

        for(int j = i + 1; j < size; j++)
        {
            iteration++;
            if(arr[j] < arr[minIndex])  
            {
                minIndex = j;
            }
        }

        if(minIndex != i)               
        {
            int a = arr[i];
            arr[i] = arr[minIndex];
            arr[minIndex] = a;
        }
    }
    return iteration;
}


int main()
{
    srand(time(0));

    const int N = 1000;
    int arr[N];   
    int arr1[N];  
    int arr2[N];  
    int arr3[N]; 
    int arr4[N];  

    cout << "Исходный массив:" << endl;
    Rand_mas(arr, N);

    
    Copy_mas(arr, arr1, N);
    Copy_mas(arr, arr2, N);
    Copy_mas(arr, arr3, N);
    Copy_mas(arr, arr4, N);


    int it_bubble = bublesort(arr1, N);
    cout << endl << "Массив 1 (бульба) " << endl;
    Print(arr1, N);

    int it_gnome = GnomeSort(arr2, N);
    cout << endl << "Массив 2 (гномья)  << endl;
    Print(arr2, N);

    int it_stalin = 0;
    int newSize = stalinSort(arr3, N, it_stalin);
    cout << endl << "Массив 3 (сталинская) " << endl;
    Print(arr3, newSize);

    int it_selection = selectionSort(arr4, N);
    cout << endl << "Массив 4 (выбором) " << endl;
    Print(arr4, N);


    cout << endl << " кол-во итераций << endl;
    cout << "Бульба:  " << it_bubble << endl;
    cout << "Гномья:       " << it_gnome << endl;
    cout << "Сталинская:   " << it_stalin << " осталось элементов: " << newSize << " из " << N << endl;
    cout << "Выбором:      " << it_selection << endl;

    return 0;
}
