#include <iostream>
#include <cstdio>

using namespace std;

struct Point
{
    int x;
    int y;
};

int main()
{
    const unsigned int N = 5;

    Point points[N] =
    {
        {3,4},
        {3,1},
        {8,9},
        {6,-3},
        {3,0}
    };

    FILE* file = fopen("data.bin", "wb");

    if (file != nullptr)
    {
        fwrite(points, sizeof(Point), N, file);
        for(int i = 0; i < N; i++)
        {
            cout << points[i].x << " " << points[i].y << endl;
        }
        fclose(file);
    }

    return 0;
}
