#include <iostream>
using namespace std;
#include "Header.h"

int main()
{
	int size;
	srand(time(0));
	cout << " Enter size ";
	cin >> size;
	int* arr = new int[size];
	fillarr(arr, size);
	printArr(arr, size);
	push(arr, &size, 20);
	printArr(arr, size);
	delete[] arr;
	return 0;
}



#pragma once
void printArr(int* arr, int size)
{
	for (int i = 0; i < size; i++)
	{
		cout << arr[i] << ' ';
	}
	cout << '\n';
}

void fillarr(int* arr, int size, int min = -10, int max = 10)
{
	for (int i = 0; i < size; i++)
	{
		arr[i] = rand() % (max - min) + min;
	}
}

void push(int*& arr, int* size, int value) 
{
	int newsize = *size + 1;
	int* newarr = new int[newsize];
	for (int i = 0; i < *size; i++)
	{
		newarr[i] = arr[i];
	}
	newarr [newsize - 1] = value;
	delete[] arr;

	arr = newarr;
	*size = newsize;
}
