#include <cstdlib>
#include <iostream>
using namespace std;
#include <ctime>


void Rand_mas(int arr[], int size)
{
    for(int i = 0; i < size; i++)
    {
        arr[i] = 1 + rand() % 50;
        cout << arr[i] << " ";
    }
    cout << endl;
}

void Print(int arr[], int size)
{
    for(int i = 0; i < size; i++)
    {
        cout << arr[i] << " ";
    }
    cout << endl;
}

int bublesort(int arr[], int size)
{
    int iteration = 0;
    for(int i = 0; i < size - 1; i++)
    {
        bool swap = false;
        for(int j = 0; j < size - 1 - i; j++)
        {
            iteration++;
            if(arr[j] > arr[j+1])
            {
                int a = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = a;

                swap = true;
            }
        }
        if(!swap)
        {
            break;
        }
    }
    return iteration;
}


void GnomeSort(int arr[], int size) {
    int i = 0;
    while (i < size) {
        if (i == 0 || arr[i] >= arr[i - 1]) {
            i++;
        } else {
            int temp = arr[i];
            arr[i] = arr[i - 1];
            arr[i - 1] = temp;
            i--;
        }
    }
}


int stalinSort(int arr[], int size) 
{
    if (size <= 0) return 0;

    int j = 0;

    for (int i = 1; i < size; i++) 
    {
        if (arr[i] >= arr[j]) 
        {
            j++;
            arr[j] = arr[i];
        }
    }

    return j + 1;
}


int main()
{
    const int N = 1000;
    int arr[N];

    cout << "Сам массив 1 " << endl;
    Rand_mas(arr, N);

    bublesort(arr, N);

    cout << "Сам массив 1 отсортированный " << endl;
    Print(arr, N);


    const int A = 1000;
    int arr2[A];

    cout << "Сам массив 2 " << endl;
    Rand_mas(arr2, A); 

    GnomeSort(arr2, A); 

    cout << "Сам массив 2 отсортированный " << endl;
    Print(arr2, A);
    return 0;



    const int B = 1000;
    int arr3[B];

    cout << "Сам массив 3 " << endl;
    Rand_mas(arr3, B); 

    stalinSort(arr3, A); 

    cout << "Сам массив 3 отсортированный " << endl;
    Print(arr3, B);
    return 0;
}
