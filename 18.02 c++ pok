#include <iostream>
using namespace std;
#include "Header.h"

int main()
{
	int size;
	srand(time(0));
	cout << " Enter size ";
	cin >> size;
	int* arr = new int[size];
	fillarr(arr, size);
	printArr(arr, size);
	int countEven = getCountEven(arr, size);
	if (countEven > 0)
	{
		int* new_arr = new int[countEven];
		fillEvenElements(arr, size, new_arr);
		printArr(new_arr, countEven);

		delete[] new_arr;
	}
	delete[] arr;
}









#pragma once
#include <iostream>
using namespace std;

void printArr(int* arr, int size)
{
	for (int i = 0; i < size; i++)
	{
		cout << arr[i] << ' ';
	}
	cout << '\n';
}

void fillarr(int* arr, int size, int min = -10, int max = 10)
{
	for (int i = 0; i < size; i++)
	{
		arr[i] = rand() % (max - min) + min;
	}
}

int getCountEven(int* arr, int size)
{
	int CountEven = 0;
	for (int i = 0; i < size; i++)
	{
		if(arr[i] % 2 ==0)
		{
			CountEven++;
		}
	}
	return CountEven;
}

void fillEvenElements(int* arr, int size, int* new_arr)
{
	int k = 0;
	for (int i = 0; i < size; i++)
	{

		if (arr[i] % 2 == 0)
		{
			new_arr[k] = arr[i];
			k++;
		}
	}
}
